{
  "name": "salient-react",
  "version": "1.0.0",
  "description": "Salient UI Component Library for React",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ry4ngch/salient-react.git"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "library",
    "salient",
    "table",
    "forms",
    "buttons"
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "build-babel": "babel src/app.js --out-file=public/scripts/app.js --presets=env,react --watch",
    "build": "webpack --mode production --config webpack.prod.js",
    "build:lib": "webpack --config webpack.lib.js",
    "build-file": "cross-env FILE=$npm_package_config_file babel $FILE --out-file=public/scripts/app.js --presets=env,react --watch",
    "demo": "cross-env echo $npm_package_config_file",
    "serve": "live-server public",
    "dev-server": "webpack serve --mode development --config webpack.dev.js --open --port 3000",
    "prepare": "pnpm run build:lib",
    "prepublishOnly": "pnpm run lint && pnpm run test"
  },
  "author": "Ryan",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "bootstrap-table": "^1.28.0",
    "classnames": "^2.5.1",
    "dotenv": "^18.0.9",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "validator": "^13.15.35"
  },
  "config": {
    "file": "src/app.js"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-scss": "^1.2.0",
    "baseline-browser-mapping": "^2.11.34",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "live-server": "^1.2.2",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "sass-migrator": "^2.6.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  }
}
